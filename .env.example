# Любой OpenAI-совместимый провайдер
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=changeme
# Нужна модель с поддержкой tool calling; бесплатные модели бывают нестабильны
LLM_MODEL=openrouter/free
# Запасные модели через запятую: при ошибке основной (лимит 429, сбой) запрос уйдёт следующей
# LLM_FALLBACK_MODELS=openrouter/free
# 0 — финальный ответ обычным текстом, без структуры (если модель плохо вызывает инструменты)
# STRUCTURED_REPLY=1

# Travelpayouts: Профиль -> API token
TRAVELPAYOUTS_TOKEN=changeme

# Необязательно:
# AGENT_RECURSION_LIMIT=60
# HTTP_TIMEOUT=20

# Сгенерируйте командой: python -c "import secrets; print(secrets.token_urlsafe(48))"
PULSE_AUTH_KEY=WiHw1vwioJT6onBEMYlXrvJYFmvv0Kejm1L6ZBCnNnBW7ZBAlWTIw1bovjTq0hO7
# Необязательно: путь к SQLite-файлу (по умолчанию pulse.sqlite3)
# PULSE_DB_PATH=pulse.sqlite3

# Необязательно: трассировка в LangSmith (каждый ход агента по шагам)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=pulse

# Необязательно: подробность логов (DEBUG, INFO, WARNING)
# LOG_LEVEL=INFO
