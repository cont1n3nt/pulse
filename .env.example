# Модель: любой OpenAI-совместимый провайдер с поддержкой tool calling.
# Проверено на claude-haiku-5-5 через https://api.smartapi.pro/v1 (значения по умолчанию).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Запасные модели через запятую: при ошибке основной (лимит 429, сбой) запрос уйдёт следующей
LLM_FALLBACK_MODELS=
# 0 — финальный ответ обычным текстом, без структуры (если модель плохо вызывает инструменты)
STRUCTURED_REPLY=

# Travelpayouts: Профиль -> API token. Без него цен перелётов нет и поездка собирается поездом
TRAVELPAYOUTS_TOKEN=

# Яндекс Расписания: https://developer.tech.yandex.ru -> подключить «API Яндекс.Расписаний».
# Без ключа поезда — демо-расписание
YANDEX_RASP_KEY=

# Локация: папка в backend/seed/ с location.json (по умолчанию sochi)
PULSE_LOCATION=

# Ключ подписи сессий. Пусто — сгенерируется при первом запуске и сохранится в томе с данными
PULSE_AUTH_KEY=

# Необязательно: предохранитель шагов агента (60) и таймаут внешних API в секундах (20)
AGENT_RECURSION_LIMIT=
HTTP_TIMEOUT=

# Необязательно: трассировка в LangSmith (каждый ход агента по шагам), LANGSMITH_TRACING=true
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Необязательно: подробность логов (DEBUG, INFO, WARNING)
LOG_LEVEL=
